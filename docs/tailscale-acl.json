// DeadDrop Tailscale ACL policy — Week 3, Day 3, updated Week 4 Day 4
//
// Scope: the two DeadDrop devices (client + server) should be able to
// reach *only each other*, on two ports — nothing else, and nothing else
// should be able to reach them, even other devices later added to this
// same tailnet for unrelated purposes:
//   - 4433 (SERVER_PORT, src/server.c) - the DeadDrop application
//     protocol itself. One-directional: client -> server only, matching
//     how the mTLS connection is actually initiated.
//   - 4434 (KEYSHARE_PORT, keyshare.h) - the mutual key-share fetch
//     added for Day 4's private-key protection. Genuinely bidirectional,
//     unlike 4433: each device is BOTH a keyshare-client (fetching its
//     own share from its peer) AND a keyshare-server (serving the
//     custody-share it holds for its peer) to the other, so this needs
//     two explicit rules, one per direction - Tailscale ACL rules are
//     not inherently bidirectional even between the same two tags.
//
// This is HuJSON (JSON + comments), which is what Tailscale's admin
// console ACL editor expects — paste this whole file in directly.
//
// Apply now: this dev machine, tagged tag:deaddrop-client, via
//   tailscale up --advertise-tags=tag:deaddrop-client
// Apply later, once a Pi is actually running Tailscale (Week 4 Day 1+):
//   tailscale up --advertise-tags=tag:deaddrop-server
{
	// Who is allowed to APPLY each tag to a device. Replace
	// "autogroup:admin" with your specific Tailscale account's login
	// (e.g. "you@example.com") if you'd rather scope it more tightly
	// than "any tailnet admin" — for a solo two-device tailnet these are
	// equivalent in practice, but the tighter form is worth knowing
	// about for when this tailnet has more than one admin someday.
	"tagOwners": {
		"tag:deaddrop-client": ["autogroup:admin"],
		"tag:deaddrop-server": ["autogroup:admin"]
	},

	// Once any custom rule exists here, Tailscale's default deny-all
	// applies to everything NOT explicitly listed below — this single
	// rule is therefore also what restricts these two devices from
	// reaching (or being reached by) anything else on the tailnet, not
	// just what it explicitly allows.
	"acls": [
		{
			"action": "accept",
			"src":    ["tag:deaddrop-client"],
			// :4433 restricts this to the DeadDrop protocol port
			// specifically, not "any port on the server device" — the
			// client only ever needs to reach this one port.
			"dst":    ["tag:deaddrop-server:4433"]
		},
		{
			// Keyshare fetch, client -> server direction: the
			// client-tagged device fetching its own custody-share
			// from the server-tagged device.
			"action": "accept",
			"src":    ["tag:deaddrop-client"],
			"dst":    ["tag:deaddrop-server:4434"]
		},
		{
			// Keyshare fetch, server -> client direction: the
			// server-tagged device fetching ITS OWN custody-share
			// from the client-tagged device - the mutual half of the
			// scheme that 4433's one-directional rule doesn't cover.
			"action": "accept",
			"src":    ["tag:deaddrop-server"],
			"dst":    ["tag:deaddrop-client:4434"]
		},
		{
			// REAL GAP FOUND AND FIXED (2026-08-24): this ACL never
			// granted SSH (port 22) at all - every prior remote
			// administration session to either device this whole
			// project only ever worked because the dev machine and
			// the target Pi happened to be physically co-located,
			// reachable over the LAN via mDNS, which bypasses this
			// ACL entirely (it only governs Tailscale-routed traffic).
			// The first time a device was genuinely remote with no
			// shared LAN (alpha, sent to a paired device's home for
			// real field testing), SSH-over-Tailscale was the only
			// path available and it was silently blocked the whole
			// time - `tailscale ping` still succeeded, since ICMP
			// diagnostics aren't gated the same way application ports
			// are, which is what made this look like a working tunnel
			// with an unrelated problem rather than an ACL gap.
			//
			// Scoped to SSH only, from the dev machine's own tag
			// (which also happens to be shared with bravo, the actual
			// production client device, per this file's own top
			// comment - the dev machine and bravo have always shared
			// tag:deaddrop-client rather than getting a distinct
			// admin-only tag, a deliberate, already-documented
			// tradeoff for this small tailnet, not a new one
			// introduced here) to both device tags, not a blanket
			// allow-everything rule.
			"action": "accept",
			"src":    ["tag:deaddrop-client"],
			"dst":    ["tag:deaddrop-server:22", "tag:deaddrop-client:22"]
		}
	]
}
